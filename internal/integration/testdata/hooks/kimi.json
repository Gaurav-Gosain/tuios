  },
  {
    "name": "PostToolUseFailure",
    "payload": {"hook_event_name": "PostToolUseFailure", "session_id": "km-1", "tool_name": "Shell"},
    "want": {"state": "working", "if_state": "needs_input", "agent_session_id": "km-1"}
  },
  {
    "name": "Stop",
    "payload": {"hook_event_name": "Stop", "session_id": "km-1"},
