[
  {
    "name": "session.start",
    "payload": {"hook_event_name": "session.start", "session_id": "T-abc"},
    "want": {"session_only": true, "agent_session_id": "T-abc"}
  },
  {
    "name": "agent.start",
    "payload": {"hook_event_name": "agent.start", "session_id": "T-abc"},
    "want": {"state": "working", "agent_session_id": "T-abc"}
  },
  {
    "name": "agent.end done",
    "payload": {"hook_event_name": "agent.end", "session_id": "T-abc", "status": "done"},
    "want": {"state": "done", "agent_session_id": "T-abc"}
  },
  {
    "name": "agent.end error",
    "payload": {"hook_event_name": "agent.end", "session_id": "T-abc", "status": "error"},
    "want": {"state": "errored", "message": "the turn ended on an error", "agent_session_id": "T-abc"}
  },
  {
    "name": "agent.end cancelled",
    "payload": {"hook_event_name": "agent.end", "session_id": "T-abc", "status": "cancelled"},
    "want": {"state": "idle", "agent_session_id": "T-abc"}
  },
  {
    "name": "agent.end with a status tuios does not know",
    "payload": {"hook_event_name": "agent.end", "session_id": "T-abc", "status": "paused"},
    "skip": "not a state change"
  },
  {
    "name": "session.start with no thread",
    "payload": {"hook_event_name": "session.start", "session_id": ""},
    "skip": "names no session"
  },
  {
    "name": "tool.call for ask_user_choice",
    "payload": {"hook_event_name": "tool.call", "session_id": "T-1", "tool": "ask_user_choice", "question": "Which approach?"},
    "want": {"state": "needs_input", "kind": "question", "message": "Which approach?", "agent_session_id": "T-1"}
  },
  {
    "name": "tool.call for any other tool",
    "payload": {"hook_event_name": "tool.call", "session_id": "T-1", "tool": "Bash"},
    "skip": "not a question"
  },
  {
    "name": "tool.result for ask_user_choice",
    "payload": {"hook_event_name": "tool.result", "session_id": "T-1", "tool": "ask_user_choice"},
    "want": {"state": "working", "if_state": "needs_input", "agent_session_id": "T-1"}
  }
]
