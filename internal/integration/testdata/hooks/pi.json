[
  {
    "name": "session_start",
    "payload": {"hook_event_name": "session_start", "session_id": "pi-1", "transcript_path": "/home/u/.pi/agent/sessions/pi-1.jsonl", "busy": false},
    "want": {"state": "idle", "agent_session_id": "pi-1", "transcript_path": "/home/u/.pi/agent/sessions/pi-1.jsonl"}
  },
  {
    "name": "session_start mid-turn after a reload",
    "payload": {"hook_event_name": "session_start", "session_id": "pi-1", "busy": true},
    "want": {"state": "working", "agent_session_id": "pi-1"}
  },
  {
    "name": "agent_start",
    "payload": {"hook_event_name": "agent_start", "session_id": "pi-1"},
    "want": {"state": "working", "agent_session_id": "pi-1"}
  },
  {
    "name": "agent_settled",
    "payload": {"hook_event_name": "agent_settled", "session_id": "pi-1"},
    "want": {"state": "done", "agent_session_id": "pi-1"}
  },
  {
    "name": "unknown event",
    "payload": {"hook_event_name": "mystery_event", "session_id": "pi-1"},
    "skip": "event not mapped"
  },
  {
    "name": "tool_call",
    "payload": {"hook_event_name": "tool_call", "session_id": "pi-1", "tool_name": "bash", "tool_input": {"command": "go test ./..."}},
    "want": {
      "state": "working",
      "if_state": "working",
      "agent_session_id": "pi-1",
      "activity": {"event": "tool", "tool": "bash", "target": "go test ./..."}
    }
  },
  {
    "name": "tool_result that succeeded",
    "payload": {"hook_event_name": "tool_result", "session_id": "pi-1", "tool_name": "bash", "tool_input": {"command": "go test ./..."}, "is_error": false},
    "want": {
      "state": "working",
      "if_state": "working",
      "agent_session_id": "pi-1",
      "activity": {"event": "tool_done", "tool": "bash", "target": "go test ./...", "ok": true}
    }
  },
  {
    "name": "tool_result that failed",
    "payload": {"hook_event_name": "tool_result", "session_id": "pi-1", "tool_name": "edit", "tool_input": {"file_path": "/src/main.go"}, "is_error": true, "error": "permission denied"},
    "want": {
      "state": "working",
      "if_state": "working",
      "agent_session_id": "pi-1",
      "activity": {"event": "tool_failed", "tool": "edit", "target": "/src/main.go", "ok": false, "text": "permission denied"}
    }
  },
  {
    "name": "prompt names the task",
    "payload": {"hook_event_name": "prompt", "session_id": "pi-1", "prompt": "fix the login bug\nand add a regression test"},
    "want": {
      "state": "working",
      "agent_session_id": "pi-1",
      "activity": {"event": "prompt", "text": "fix the login bug"}
    }
  },
  {
    "name": "tool_result with no tool name",
    "payload": {"hook_event_name": "tool_result", "session_id": "pi-1", "tool_input": {}, "is_error": false},
    "want": {
      "state": "working",
      "if_state": "working",
      "agent_session_id": "pi-1"
    }
  },
  {
    "name": "ui_prompt_start for a confirm",
    "payload": {"hook_event_name": "ui_prompt_start", "session_id": "pi-1", "kind": "confirm", "title": "Allow rm -rf build?", "busy": true},
    "want": {"state": "needs_input", "kind": "approval", "message": "Allow rm -rf build?", "agent_session_id": "pi-1"}
  },
  {
    "name": "ui_prompt_start for a choice",
    "payload": {"hook_event_name": "ui_prompt_start", "session_id": "pi-1", "kind": "select", "title": "Pick a model", "busy": false},
    "want": {"state": "needs_input", "kind": "question", "message": "Pick a model", "agent_session_id": "pi-1"}
  },
  {
    "name": "ui_prompt_start with no title",
    "payload": {"hook_event_name": "ui_prompt_start", "session_id": "pi-1", "kind": "custom", "busy": true},
    "want": {"state": "needs_input", "kind": "question", "message": "waits for an answer", "agent_session_id": "pi-1"}
  },
  {
    "name": "ui_prompt_end in a turn",
    "payload": {"hook_event_name": "ui_prompt_end", "session_id": "pi-1", "kind": "confirm", "busy": true},
    "want": {"state": "working", "if_state": "needs_input", "agent_session_id": "pi-1"}
  },
  {
    "name": "ui_prompt_end at rest",
    "payload": {"hook_event_name": "ui_prompt_end", "session_id": "pi-1", "kind": "select", "busy": false},
    "want": {"state": "idle", "if_state": "needs_input", "agent_session_id": "pi-1"}
  }
]
