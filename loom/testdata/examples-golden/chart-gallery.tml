  <col gap="1" pad="1 1">
    <row gap="2">
      <stack w="26"><stat h="3" label="passed" value="{state.passed}" delta="+12" role="success"/><sparkline values="state.trend.passed" role="success" pad="2 1 0 2"/></stack>
      <stack w="26"><stat h="3" label="failed" value="{state.failed}" delta="+3" role="error"/><sparkline values="state.trend.failed" role="error" pad="2 1 0 2"/></stack>
      <stack w="26"><stat h="3" label="skipped" value="{state.skipped}" role="dim"/></stack>
      <stack w="26"><stat h="3" label="wall time" value="{state.wall}" delta="-2.1s"/><sparkline values="state.trend.wall" role="info" pad="2 1 0 2"/></stack>
      <col w="fill" gap="0">
        <gauge label="pass rate" value="{pct(state.passed, state.passed + state.failed)}" role="success"/>
        <gauge label="cpu      " value="{state.cpu}" role="info"/>
        <progress label="disk 72%" value="{state.disk}" role="warning"/>
      </col>
    </row>
    <row gap="4" h="fill:5">
      <col w="fill:9"><row gap="2"><heading level="2" w="fill">Time by package</heading><text role="mute">seconds</text></row><bar data="state.byPkg" x="pkg" y="secs" dir="h" role="error" h="fill"/></col>
      <bar w="fill:11" data="state.runs" x="run" y="secs" role="info" title="Suite time, last 30 runs" h="fill"/>
    </row>
    <row gap="4" h="fill:6">
      <line w="fill:3" data="state.lat" x="t" y="p50,p95" axis="true" title="Request latency, ms" h="fill"/>
      <area w="fill:2" data="state.mem" x="t" y="mb" role="series3" title="Memory, MB" h="fill"/>
    </row>
    <row gap="4" h="fill:6">
      <heatmap w="54" data="state.heat" x="hour" y="day" v="builds" title="Builds per hour" h="fill"/>
      <pie w="fill:2" data="state.share" label="lang" v="lines" style="donut" title="Lines by language" h="fill"/>
      <histogram w="fill:2" values="state.latency" bins="24" title="Latency distribution, ms" h="fill"/>
    </row>
    <row gap="4">
      <col w="fill"><sparkline values="state.flaky" role="warning" title="flaky "/><sparkline values="state.allocs" role="series1" title="allocs"/></col>
      <col w="fill"><sparkline values="state.trend.wall" role="info" title="wall  "/><sparkline values="state.trend.passed" role="success" title="passed"/></col>
    </row>
  </col>
