a: fg=fg bg=panel
b: bg=panel
c: fg=fg bg=panel bold
d: fg=fg bg=panel italic
e: fg=fg bg=panel underline
f: fg=fg bg=panel strike
g: fg=info bg=panel
h: fg=success bg=panel
i: fg=accent-bright bg=panel bold
j: fg=info bg=panel underline
k: bg=panel underline
l: fg=dim bg=panel
m: fg=mute bg=panel
