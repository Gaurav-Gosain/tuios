{
  "type": "tml",
  "version": 1,
  "title": "go test ./...",
  "state": {
    "passed": 412,
    "failed": 3,
    "skipped": 9,
    "secs": [
      41,
      39,
      44,
      40,
      52,
      47,
      38
    ],
    "failures": [
      {
        "pkg": "internal/session",
        "test": "TestAttachRace",
        "ms": 2210
      },
      {
        "pkg": "internal/app",
        "test": "TestDockClick",
        "ms": 840
      },
      {
        "pkg": "vt",
        "test": "TestKittyPlaceholder",
        "ms": 120
      }
    ]
  },
  "children": [
    {
      "type": "col",
      "gap": 1,
      "pad": "1",
      "children": [
        {
          "type": "row",
          "gap": 3,
          "children": [
            {
              "type": "stat",
              "label": "passed",
              "value": "{state.passed}",
              "role": "success"
            },
            {
              "type": "stat",
              "label": "failed",
              "value": "{state.failed}",
              "role": "error"
            },
            {
              "type": "stat",
              "label": "skipped",
              "value": "{state.skipped}",
              "role": "dim"
            },
            {
              "type": "spacer"
            },
            {
              "type": "gauge",
              "value": "{pct(state.passed, state.passed + state.failed)}",
              "w": "14"
            }
          ]
        },
        {
          "type": "bar",
          "data": "state.secs",
          "h": "4",
          "title": "Seconds per run, last 7"
        },
        {
          "type": "card",
          "title": "Failures",
          "meta": "{len(state.failures)}",
          "role": "error",
          "children": [
            {
              "type": "table",
              "rows": "state.failures",
              "key": "test",
              "sort": "ms:desc",
              "select": "single",
              "on-select": "emit('open', event.row)",
              "children": [
                {
                  "type": "column",
                  "field": "pkg",
                  "title": "Package",
                  "w": "fill"
                },
                {
                  "type": "column",
                  "field": "test",
                  "title": "Test",
                  "w": "fill:2"
                },
                {
                  "type": "column",
                  "field": "ms",
                  "title": "Time",
                  "align": "right",
                  "format": "dur(value, 'ms')"
                }
              ]
            }
          ]
        },
        {
          "type": "row",
          "gap": 2,
          "children": [
            {
              "type": "button",
              "key": "r",
              "on-press": "emit('rerun', state.failures)",
              "children": [
                "Rerun failed"
              ]
            },
            {
              "type": "button",
              "key": "o",
              "on-press": "emit('log')",
              "children": [
                "Open log"
              ]
            },
            {
              "type": "spacer"
            },
            {
              "type": "text",
              "role": "mute",
              "children": [
                "esc close"
              ]
            }
          ]
        }
      ]
    }
  ]
}
