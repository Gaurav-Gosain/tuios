# Measured run time in seconds of each top-level test of the packages
# scripts/go-test-lanes.sh splits into lanes. The script cuts the lanes by
# these times. A test this file does not name counts at the mean of its
# package. Refresh it when the lanes in a CI log drift apart:
#
#   go test -count=1 -json ./internal/app ./internal/session > /tmp/tests.json
#   { sed -n '/^#/p' scripts/go-test-lanes.durations
#     grep '^{' /tmp/tests.json | jq -rs -f scripts/go-test-lanes-durations.jq | sort
#   } > /tmp/durations && mv /tmp/durations scripts/go-test-lanes.durations
