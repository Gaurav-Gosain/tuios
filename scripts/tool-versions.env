# The versions of the tools the gate and CI run. scripts/check.sh and the
# justfile read this file, and .github/workflows/lint.yml reads it in a step.
# Bump a version here only. Pinned, so a new release cannot fail a pull
# request that changed nothing.
GOLANGCI_LINT_VERSION=v2.14.0
GOVULNCHECK_VERSION=v1.9.0
